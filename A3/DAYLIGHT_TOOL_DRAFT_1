def get_br18_threshold():
    # reads the percentage from the calculate screen, falls back to the
    # standard BR18 10% rule if someone types something silly in the box
    try:
        value = float(threshold_var.get())
        if value <= 0:
            return 10.0
        return value
    except ValueError:
        return 10.0


def start_calculation():
    global analysis_results, analysis_in_progress

    if ifc_file_path is None:
        messagebox.showwarning("No File", "Please select an IFC file first!")
        return

    if analysis_in_progress:
        messagebox.showinfo("In Progress", "Analysis is already running...")
        return

    analysis_in_progress = True
    start_calc_button.config(state=DISABLED)

    def run_analysis():
        global analysis_results, analysis_in_progress
        try:
            analysis_results = run_ifc_analysis(ifc_file_path, update_status)
            menu.after(0, lambda: messagebox.showinfo("Complete", "Analysis completed successfully!\nGo to 'Values' to see results."))
        except Exception as e:
            menu.after(0, lambda: messagebox.showerror("Error", f"Analysis failed:\n{str(e)}"))
            menu.after(0, lambda: update_status("Analysis failed"))
        finally:
            analysis_in_progress = False
            menu.after(0, lambda: start_calc_button.config(state=NORMAL))

    thread = threading.Thread(target=run_analysis)
    thread.daemon = True
    thread.start()


def is_relevant_room(room):
    full_name = (room['long_name'] if room['long_name'] else room['name']).lower()
    for excluded in EXCLUDED_TYPES:
        if excluded in full_name:
            return False
    for relevant in RELEVANT_TYPES:
        if relevant in full_name:
            return True
    return False


def show_values():
    global analysis_results

    show_frame("values")

    for item in results_tree.get_children():
        results_tree.delete(item)

    if analysis_results is None:
        summary_label.config(text="No analysis results available.\nPlease run calculation first.")
        return

    threshold = get_br18_threshold()
    results_tree.heading("br18", text=f"BR18 (≥{threshold:.0f}%)", anchor=CENTER)

    pass_count = 0
    fail_count = 0

    by_storey = {}
    for room in analysis_results['rooms']:
        storey = room['storey']
        if storey not in by_storey:
            by_storey[storey] = {
                'relevant': [],
                'misc_count': 0,
                'misc_floor_area': 0,
                'misc_window_area': 0,
                'misc_window_count': 0
            }

        if is_relevant_room(room):
            by_storey[storey]['relevant'].append(room)
        else:
            by_storey[storey]['misc_count'] += 1
            if room['floor_area']:
                by_storey[storey]['misc_floor_area'] += room['floor_area']
            by_storey[storey]['misc_window_area'] += room['total_window_area']
            by_storey[storey]['misc_window_count'] += len(room['windows'])

    for storey_name in sorted(by_storey.keys()):
        storey_data = by_storey[storey_name]

        storey_id = results_tree.insert("", "end", text=storey_name, values=("", "", "", "", ""), tags=('storey',))

        storey_floor_total = 0
        storey_window_total = 0

        for room in sorted(storey_data['relevant'], key=lambda x: x['name']):
            display_name = room['long_name'] if room['long_name'] else room['name']
            if len(display_name) > 40:
                display_name = display_name[:37] + "..."

            floor_str = f"{room['floor_area']:.2f}" if room['floor_area'] else "N/A"
            window_str = f"{room['total_window_area']:.2f}" if room['total_window_area'] > 0 else "0.00"

            ratio = None
            if room['floor_area'] and room['floor_area'] > 0 and room['total_window_area'] > 0:
                ratio = (room['total_window_area'] / room['floor_area']) * 100
                ratio_str = f"{ratio:.1f}%"
            else:
                ratio_str = "-"

            full_name = room['long_name'] if room['long_name'] else room['name']
            compliance = check_br18(ratio, full_name, threshold)

            if compliance == "OK":
                row_tag = 'pass'
                pass_count += 1
            elif compliance == "FAIL":
                row_tag = 'fail'
                fail_count += 1
            else:
                row_tag = 'neutral'

            window_count = len(room['windows'])

            results_tree.insert(storey_id, "end", text=display_name,
                                 values=(floor_str, window_str, ratio_str, window_count, compliance),
                                 tags=(row_tag,))

            if room['floor_area']:
                storey_floor_total += room['floor_area']
            storey_window_total += room['total_window_area']

        if storey_data['misc_count'] > 0:
            misc_floor = storey_data['misc_floor_area']
            misc_window = storey_data['misc_window_area']

            misc_floor_str = f"{misc_floor:.2f}" if misc_floor > 0 else "N/A"
            misc_window_str = f"{misc_window:.2f}" if misc_window > 0 else "0.00"

            if misc_floor > 0 and misc_window > 0:
                misc_ratio_str = f"{(misc_window / misc_floor) * 100:.1f}%"
            else:
                misc_ratio_str = "-"

            results_tree.insert(storey_id, "end",
                                 text=f"Miscellaneous ({storey_data['misc_count']} rooms)",
                                 values=(misc_floor_str, misc_window_str, misc_ratio_str,
                                         storey_data['misc_window_count'], "N/A"),
                                 tags=('misc',))

            storey_floor_total += misc_floor
            storey_window_total += misc_window

        storey_ratio = f"{(storey_window_total / storey_floor_total) * 100:.1f}%" if storey_floor_total > 0 and storey_window_total > 0 else "-"
        results_tree.item(storey_id, values=(f"{storey_floor_total:.2f}", f"{storey_window_total:.2f}", storey_ratio, "", ""))

    for item in results_tree.get_children():
        results_tree.item(item, open=True)

    summary_text = (
        f"Total Floor Area: {analysis_results['total_floor_area']:.2f} m²  |  "
        f"Total Window Area: {analysis_results['total_window_area']:.2f} m²  |  "
        f"Overall Ratio: {analysis_results['overall_ratio']:.1f}%\n"
        f"Rooms: {analysis_results['rooms_with_windows']}/{analysis_results['total_rooms']} with windows  |  "
        f"BR18 ≥{threshold:.0f}%: {pass_count} OK, {fail_count} FAIL"
    )
    summary_label.config(text=summary_text)


def export_results():
    global analysis_results

    if analysis_results is None:
        messagebox.showwarning("No Data", "No analysis results to export!")
        return

    filename = filedialog.asksaveasfilename(
        title="Save Results",
        defaultextension=".csv",
        filetypes=(("CSV files", "*.csv"), ("All files", "*.*"))
    )

    if not filename:
        return

    threshold = get_br18_threshold()

    try:
        with open(filename, 'w', encoding='utf-8') as f:
            f.write(f"Storey,Room Name,Floor Area (m2),Window Area (m2),Ratio (%),Window Count,BR18 >= {threshold:.0f}%\n")

            by_storey = {}
            for room in analysis_results['rooms']:
                storey = room['storey']
                if storey not in by_storey:
                    by_storey[storey] = {'relevant': [], 'misc_floor': 0, 'misc_window': 0, 'misc_count': 0, 'misc_windows': 0}

                if is_relevant_room(room):
                    by_storey[storey]['relevant'].append(room)
                else:
                    by_storey[storey]['misc_count'] += 1
                    if room['floor_area']:
                        by_storey[storey]['misc_floor'] += room['floor_area']
                    by_storey[storey]['misc_window'] += room['total_window_area']
                    by_storey[storey]['misc_windows'] += len(room['windows'])

            for storey_name in sorted(by_storey.keys()):
                storey_data = by_storey[storey_name]

                for room in sorted(storey_data['relevant'], key=lambda x: x['name']):
                    display_name = room['long_name'] if room['long_name'] else room['name']
                    display_name = display_name.replace(',', ';')

                    floor_area = f"{room['floor_area']:.2f}" if room['floor_area'] else "N/A"
                    window_area = f"{room['total_window_area']:.2f}"

                    ratio = None
                    if room['floor_area'] and room['floor_area'] > 0 and room['total_window_area'] > 0:
                        ratio = (room['total_window_area'] / room['floor_area']) * 100
                        ratio_str = f"{ratio:.1f}"
                    else:
                        ratio_str = "-"

                    full_name = room['long_name'] if room['long_name'] else room['name']
                    compliance = check_br18(ratio, full_name, threshold)

                    f.write(f"{storey_name},{display_name},{floor_area},{window_area},{ratio_str},{len(room['windows'])},{compliance}\n")

                if storey_data['misc_count'] > 0:
                    misc_floor = f"{storey_data['misc_floor']:.2f}" if storey_data['misc_floor'] > 0 else "N/A"
                    misc_window = f"{storey_data['misc_window']:.2f}"
                    if storey_data['misc_floor'] > 0 and storey_data['misc_window'] > 0:
                        misc_ratio = f"{(storey_data['misc_window'] / storey_data['misc_floor']) * 100:.1f}"
                    else:
                        misc_ratio = "-"
                    f.write(f"{storey_name},Miscellaneous ({storey_data['misc_count']} rooms),{misc_floor},{misc_window},{misc_ratio},{storey_data['misc_windows']},N/A\n")

            f.write(f"\nSUMMARY\n")
            f.write(f"Total Floor Area,{analysis_results['total_floor_area']:.2f} m2\n")
            f.write(f"Total Window Area,{analysis_results['total_window_area']:.2f} m2\n")
            f.write(f"Overall Ratio,{analysis_results['overall_ratio']:.1f}%\n")
            f.write(f"BR18 threshold used,{threshold:.1f}%\n")
            f.write(f"Rooms with Windows,{analysis_results['rooms_with_windows']}/{analysis_results['total_rooms']}\n")
            f.write(f"Windows Assigned,{analysis_results['windows_assigned']}/{analysis_results['total_windows']}\n")

        messagebox.showinfo("Export Complete", f"Results exported to:\n{filename}")
    except Exception as e:
        messagebox.showerror("Export Error", f"Failed to export:\n{str(e)}")


