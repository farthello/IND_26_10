def find_default_model():
    # tries to find the model the same way the other forensic BIM scripts do -
    # look next to the script first, then fall back to the Blender text path
    # if we happen to be running inside Bonsai
    try:
        dir_path = Path(__file__).parent
    except NameError:
        dir_path = Path.cwd()

    candidate = Path.joinpath(dir_path, 'model', MODELNAME).with_suffix('.ifc')
    if candidate.exists():
        return candidate

    try:
        import bpy
        candidate = Path.joinpath(
            Path(bpy.context.space_data.text.filepath).parent, 'model', MODELNAME
        ).with_suffix('.ifc')
        if candidate.exists():
            return candidate
    except Exception:
        pass

    return None


